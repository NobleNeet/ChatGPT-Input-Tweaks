{
  "manifest_version": 3,
  "name": "ChatGPT Enter Key",
  "version": "0.9.0",
  "description": "ChatGPT の入力欄で Enter=改行、Ctrl+Enter=送信 にします。IME 変換中の Enter には一切干渉しません。",
  "content_scripts": [
    {
      "matches": ["https://chatgpt.com/*"],
      "js": ["content.js"],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": false
    }
  ]
}
